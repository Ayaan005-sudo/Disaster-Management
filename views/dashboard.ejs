<% layout("/layouts/boilerplate.ejs") %>
<% extraCSS=`<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />`%>
<% extraJS = `<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
              <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

` %>

<div class="container-fluid text-white p-4">
  <h2 class="text-center mb-4">Disaster-Management Dashboard</h2>

  <!-- ===== TOP ROW ===== -->
  <div class="row mb-3">
    <!-- Active Incidents -->
    <div class="col-md-4 mb-3 mb-md-0">
      <div class="dashboard-box text-center">
        <h5>Active Incidents</h5>
        <h1>21</h1>
      </div>
    </div>

    <!-- Last Updated -->
    <div class="col-md-8">
      <div class="date-box text-center">
        <h5>Last updated on</h5>
        <p class="mt-2"><%= date %></p>
      </div>
    </div>
  </div>

  <!-- ===== CHARTS ROW ===== -->
  <div class="row mb-4 text-center">
    <!-- Donut Chart -->
    <div class="col-md-6 mb-3 mb-md-0">
      <div class="chart-card">
        <canvas id="disasterDonutChart" style="max-width:300px;"></canvas>
      </div>
    </div>

    <!-- Line Chart -->
    <div class="col-md-6">
      <div class="chart-card">
        <canvas id="countryLineChart" style="max-width:500px;"></canvas>
      </div>
    </div>
  </div>

  <!-- ===== MAP SECTION ===== -->
  <div class="row">
    <div class="col-12">
      <div class="map-card" style="height:400px;">
        <div
          id="map"
          style="width:100%; height:100%; border-radius:10px;">
        </div>
      </div>
    </div>
  </div>
</div>
