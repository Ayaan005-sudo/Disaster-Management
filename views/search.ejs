<% layout("/layouts/boilerplate.ejs") %>

<div class="container  text-white bg-dark">

  <h1 class="text-center text-light mb-2">Search Results</h1>
  <h5 class="text-center text-secondary mb-4">
    The results are for <span class="text-danger"><%= country %></span>
  </h5>

  <div class="row row-cols-1 row-cols-md-3 g-4">

    <% for (e of res1.events) { %>
      <div class="col">
        <div class="card bg-dark text-white h-100 border-secondary">

          <div class="card-body">
            <h5 class="card-title"><%= e.title %></h5>

            <h6 class="card-subtitle mb-2 text-secondary">
              <%= e.description || "No description available" %>
            </h6>

            <% if (e.link) { %>
              <a
                href="<%= e.link %>"
                target="_blank"
                class="btn btn-danger btn-sm mt-2">
                Read More
              </a>
            <% } %>
          </div>

        </div>
      </div>
    <% } %>

  </div>
</div>
