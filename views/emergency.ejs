<%layout("/layouts/boilerplate.ejs")%>

<div id="eme">
  <button onclick="sos()">🆘 EMERGENCY BUTTON</button>
</div>

<script>
function sos() {
  if (/Mobi|Android/i.test(navigator.userAgent)) {
    location.href = "tel:1236459870";

    navigator.geolocation.getCurrentPosition(pos => {
      const msg =
        `EMERGENCY! Location: https://maps.google.com/?q=${pos.coords.latitude},${pos.coords.longitude}`;
      location.href =
        "sms:1236549871?body=" + encodeURIComponent(msg);
    });
  } else {
    navigator.geolocation.getCurrentPosition(pos => {
      const msg =
        `EMERGENCY! Location: https://maps.google.com/?q=${pos.coords.latitude},${pos.coords.longitude}`;
      location.href =
        `mailto:user06@gmail.com?subject=SOSALERT&body=${encodeURIComponent(msg)}`;
      alert("Mail sent");
    });
  }
}
</script>
